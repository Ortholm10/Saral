# Copy this file to backend/.env and fill in your own values.
# backend/.env is gitignored - never commit real keys.

# --- Supabase (Project Settings -> API) ---
# The bare project URL, e.g. https://abcdefgh.supabase.co
# Do not include /rest/v1 - supabase-py appends that itself.
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_key

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key

# --- Optional: everything below has a working default ---

# Gemini model used for simplification, translation and the Q&A agent.
# If this model is not available for your key, the server logs a warning and
# automatically falls back to a current flash model rather than failing.
GEMINI_MODEL=gemini-3.6-flash

# Default language for generated output when the request does not specify one.
DEFAULT_LANGUAGE=Kannada

# Tesseract language packs, "+"-joined. Add kan once the Kannada pack is
# installed (see the README). Packs that are missing are skipped, not fatal.
OCR_LANGUAGES=eng

# Full path to tesseract.exe. Leave blank to auto-detect from PATH and the
# standard Windows install locations.
TESSERACT_CMD=

# Largest form photo accepted by /api/documents/upload, in megabytes.
MAX_UPLOAD_MB=10

# Comma-separated browser origins allowed to call this API (Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
